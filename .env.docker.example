# Copie este arquivo para .env.docker somente no computador que hospedará o sistema.
# .env.docker é ignorado pelo Git. Não envie suas senhas ao repositório.

POSTGRES_DB=ds_legacy
POSTGRES_USER=ds_legacy
POSTGRES_PASSWORD=troque-por-uma-senha-longa-e-unica

LIBRARIAN_USERNAME=biblioteca
LIBRARIAN_PASSWORD=troque-por-outra-senha-forte
LIBRARIAN_NAME=Responsável da Biblioteca

DIRECTOR_USERNAME=diretor
DIRECTOR_PASSWORD=troque-por-uma-terceira-senha-forte
DIRECTOR_NAME=Diretor

SESSION_HOURS=8

# Para apresentação apenas neste PC ou na rede local por HTTP, use false.
# Para acesso externo por um endereço HTTPS, use true.
COOKIE_SECURE=false

# 127.0.0.1: somente este PC e um túnel instalado nele acessam a porta.
# 0.0.0.0: permite acesso pela rede local; libere a porta 8000 apenas em rede privada.
APP_BIND_ADDRESS=127.0.0.1
