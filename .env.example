# Endereço fornecido pelo serviço PostgreSQL. Nunca coloque este valor no JavaScript do navegador.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ds_legacy

# Use true quando o provedor exigir SSL. Mantenha a validação do certificado habilitada sempre que possível.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

PORT=8000
NODE_ENV=development
SESSION_HOURS=8
COOKIE_SECURE=false

# Contas criadas/atualizadas por "npm run db:init".
# Troque as senhas antes de publicar o sistema.
LIBRARIAN_USERNAME=testebiblioteca
LIBRARIAN_PASSWORD=Biblioteca@123
LIBRARIAN_NAME=Responsável da Biblioteca
DIRECTOR_USERNAME=testediretor
DIRECTOR_PASSWORD=Diretor@123
DIRECTOR_NAME=Diretor Teste
